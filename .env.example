# === 必填 ===
# Anthropic API key（意圖解析 + agent 工具編排）
ANTHROPIC_API_KEY=sk-ant-...
# 必須是支援 structured outputs 的模型：
# claude-opus-5 / claude-opus-4-8 / claude-sonnet-5 / claude-haiku-4-5 / claude-fable-5
ANTHROPIC_MODEL=claude-opus-5
# === 選填：評審一鍵登入 ===
# 開啟後 /api/auth/demo 會用下面這組共用帳密建立 session，登入頁出現「評審一鍵進入 Demo」按鈕。
# 這是一組公開的共用憑證：只在給評審看的 demo 站點開啟，正式環境務必保持 false。
# 注意：所有點擊者共用同一帳號，會看到彼此的對話，且共用同一個速率限制配額。
DEMO_LOGIN_ENABLED=false
DEMO_EMAIL=
DEMO_PASSWORD=

# === 選填：資料存放 ===
# SQLite 檔案目錄。不設則用專案下的 .data/
# 部署到伺服器時指向持久化且已納入備份的目錄，例：/var/lib/flowpilot
DATA_DIR=

# === 選填：測試網真實轉賬（M4）===
# 不填時 execute_transfer 返回模擬交易哈希（demo 也能走通全流程）
# 注意：只用測試錢包私鑰，切勿使用真實資產錢包！
WALLET_PRIVATE_KEY=0x...
ENABLE_LIVE_TESTNET_TRANSFERS=false
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# === 選填：LI.FI 真實報價（M2）===
# 留空時 get_routes 使用高保真 mock 數據
LIFI_API_KEY=
LIFI_FROM_CHAIN=
LIFI_TO_CHAIN=
LIFI_FROM_TOKEN=
LIFI_TO_TOKEN=
LIFI_DEMO_FROM_ADDRESS=
LIFI_DEMO_TO_ADDRESS=
LIFI_TOKEN_DECIMALS=6
